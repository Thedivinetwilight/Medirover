# ============================================================
# Medirover — storage rules (master directive §3)
# Canonical artifacts are tracked; everything regenerable,
# temporary, or build output is ignored.
# ============================================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.tox/
.venv/
venv/
build/
dist/

# Node (no build step is used, but guard anyway)
node_modules/
npm-debug.log*

# Embedded platform / firmware toolchains (future M10)
.pio/
platformio.ini.local

# Runtime databases & logs — never commit (directive §14, §26)
data/*.db
data/*.db-*
data/*.sqlite*
*.log
logs/

# Results: keep ONLY canonical artifacts (directive §3, §24)
results/*
!results/test_history.jsonl
!results/persistence_validation.json
!results/storage_audit.json
!results/clean_checkout_validation.json

# Secrets — never commit (directive §29)
.env
.env.*
!.env.example
secrets/

# OS / editor noise
.DS_Store
.idea/
.vscode/
